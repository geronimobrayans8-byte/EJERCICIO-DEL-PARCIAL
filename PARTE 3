import numpy as np
import matplotlib.pyplot as plt
from scipy.interpolate import CubicSpline
from scipy.optimize import root_scalar

# 1. Datos experimentales
f = np.array([10.0, 12.5, 15.0, 17.5, 20.0, 22.5, 25.0, 27.5, 30.0, 32.5, 35.0, 37.5, 40.0, 42.5, 45.0,
              47.5, 50.0, 52.5, 55.0, 57.5, 60.0, 62.5, 65.0, 67.5, 70.0, 72.5, 75.0, 77.5, 80.0, 82.5,
              85.0, 87.5, 90.0, 92.5, 95.0, 97.5, 100.0, 102.5, 105.0, 107.5])

V = np.array([0.842, 0.911, 0.986, 1.062, 1.143, 1.227, 1.314, 1.401, 1.482, 1.551, 1.216, 1.048, 0.866, 0.689, 0.521,
              0.364, 0.223, 0.103, 0.012, -0.041, -0.057, -0.034, 0.018, 0.096, 0.197, 0.318, 0.452, 0.579, 0.700, 0.809,
              0.611, 0.688, 0.756, 0.811, 0.856, 0.894, 0.926, 0.954, 0.980, 1.004])

# 2. Creación del Spline Cúbico Natural
spline_V = CubicSpline(f, V, bc_type='natural')

# 3. Cálculo de Raíces Básicas (Interpolación Lineal)
# Intervalo 1: [55.0, 57.5]
f1_a, V1_a = 55.0, 0.012
f1_b, V1_b = 57.5, -0.041
raiz1_lin = f1_a - V1_a * (f1_b - f1_a) / (V1_b - V1_a)

# Intervalo 2: [62.5, 65.0]
f2_a, V2_a = 62.5, -0.034
f2_b, V2_b = 65.0, 0.018
raiz2_lin = f2_a - V2_a * (f2_b - f2_a) / (V2_b - V2_a)

# 4. Refinamiento aplicando Bisección algorítmica sobre el Spline Cúbico
# root_scalar con method='bisect' ejecuta el método de bisección puro
sol_raiz1_spline = root_scalar(spline_V, bracket=[55.0, 57.5], method='bisect')
sol_raiz2_spline = root_scalar(spline_V, bracket=[62.5, 65.0], method='bisect')

print("--- RESULTADOS NUMÉRICOS (4 Decimales) ---")
print(f"PRIMER CRUCE POR CERO (Intervalo [55.0, 57.5] kHz):")
print(f"  Estimación Básica (Lineal) : {raiz1_lin:.4f} kHz")
print(f"  Refinamiento (Spline)      : {sol_raiz1_spline.root:.4f} kHz")

print(f"\nSEGUNDO CRUCE POR CERO (Intervalo [62.5, 65.0] kHz):")
print(f"  Estimación Básica (Lineal) : {raiz2_lin:.4f} kHz")
print(f"  Refinamiento (Spline)      : {sol_raiz2_spline.root:.4f} kHz")

# 5. Gráfico enfocado en la zona de cruces por cero
f_zoom = np.linspace(50, 70, 400)

plt.figure(figsize=(10, 6))
plt.plot(f_zoom, spline_V(f_zoom), 'b-', linewidth=2, label='Spline Cúbico V(f)')
plt.axhline(0, color='black', linewidth=1.5, linestyle='--', label='Nivel Cero (Umbral de Alarma)')

# Puntos de datos cercanos
f_pts = f[(f >= 50) & (f <= 70)]
V_pts = V[(f >= 50) & (f <= 70)]
plt.scatter(f_pts, V_pts, color='black', s=40, zorder=5, label='Datos de Ensayo')

# Marcar las raíces del spline
plt.scatter([sol_raiz1_spline.root, sol_raiz2_spline.root], [0, 0], 
            color='red', marker='X', s=120, zorder=6, label='Raíces Refinadas (Spline)')

plt.title('Detección de Cruces por Cero - Voltaje V(f)', fontsize=14)
plt.xlabel('Frecuencia f (kHz)', fontsize=12)
plt.ylabel('Voltaje V (V)', fontsize=12)
plt.grid(True, linestyle=':', alpha=0.7)
plt.legend()
plt.tight_layout()
plt.show()
