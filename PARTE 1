import numpy as np
import matplotlib.pyplot as plt
from scipy.interpolate import CubicSpline

# 1. Ingreso de los datos del ensayo
f = np.array([10.0, 12.5, 15.0, 17.5, 20.0, 22.5, 25.0, 27.5, 30.0, 32.5, 35.0, 37.5, 40.0, 42.5, 45.0,
              47.5, 50.0, 52.5, 55.0, 57.5, 60.0, 62.5, 65.0, 67.5, 70.0, 72.5, 75.0, 77.5, 80.0, 82.5,
              85.0, 87.5, 90.0, 92.5, 95.0, 97.5, 100.0, 102.5, 105.0, 107.5])

V = np.array([0.842, 0.911, 0.986, 1.062, 1.143, 1.227, 1.314, 1.401, 1.482, 1.551, 1.216, 1.048, 0.866, 0.689, 0.521,
              0.364, 0.223, 0.103, 0.012, -0.041, -0.057, -0.034, 0.018, 0.096, 0.197, 0.318, 0.452, 0.579, 0.700, 0.809,
              0.611, 0.688, 0.756, 0.811, 0.856, 0.894, 0.926, 0.954, 0.980, 1.004])

Z = np.array([182.4, 178.9, 175.1, 171.0, 166.8, 162.7, 158.9, 155.4, 152.0, 149.0, 146.1, 145.2, 145.8, 147.3, 149.9,
              153.5, 158.0, 163.2, 168.9, 174.8, 180.5, 186.2, 191.5, 196.2, 200.1, 203.1, 205.2, 206.3, 206.1, 204.7,
              198.0, 194.4, 190.9, 187.8, 185.1, 183.0, 181.6, 180.8, 180.6, 180.9])

# Frecuencias a evaluar
f_eval = [41.0, 73.0]

# --- FUNCIÓN: Interpolación de Lagrange (Grado 2) ---
def lagrange_grado2(f_target, f_data, y_data):
    # Encontrar los 3 índices más cercanos
    idx = np.argsort(np.abs(f_data - f_target))[:3]
    f_p = f_data[idx]
    y_p = y_data[idx]
    
    # Calcular el valor interpolado
    L0 = ((f_target - f_p[1]) * (f_target - f_p[2])) / ((f_p[0] - f_p[1]) * (f_p[0] - f_p[2]))
    L1 = ((f_target - f_p[0]) * (f_target - f_p[2])) / ((f_p[1] - f_p[0]) * (f_p[1] - f_p[2]))
    L2 = ((f_target - f_p[0]) * (f_target - f_p[1])) / ((f_p[2] - f_p[0]) * (f_p[2] - f_p[1]))
    
    return y_p[0]*L0 + y_p[1]*L1 + y_p[2]*L2

# --- CÁLCULOS: Spline Cúbico Natural ---
# bc_type='natural' fuerza a que la segunda derivada en los extremos sea cero.
spline_V = CubicSpline(f, V, bc_type='natural')
spline_Z = CubicSpline(f, Z, bc_type='natural')

# Imprimir Resultados Numéricos
print("--- RESULTADOS NUMÉRICOS (4 Decimales) ---")
for freq in f_eval:
    v_lag = lagrange_grado2(freq, f, V)
    z_lag = lagrange_grado2(freq, f, Z)
    v_spl = spline_V(freq)
    z_spl = spline_Z(freq)
    
    print(f"\nPara f = {freq} kHz:")
    print(f"  [Lagrange Grado 2] V = {v_lag:.4f} V  |  |Z| = {z_lag:.4f} Ohmios")
    print(f"  [Spline Cúbico]    V = {v_spl:.4f} V  |  |Z| = {z_spl:.4f} Ohmios")

# --- GRÁFICOS PARA VISUALIZACIÓN ---
f_smooth = np.linspace(f.min(), f.max(), 500)

plt.figure(figsize=(12, 10))

# Gráfico 1: Voltaje vs Frecuencia
plt.subplot(2, 1, 1)
plt.plot(f_smooth, spline_V(f_smooth), 'b-', label='Spline Cúbico Natural', linewidth=2)
plt.scatter(f, V, color='black', label='Datos Experimentales', zorder=5, s=20)
for freq in f_eval:
    plt.scatter(freq, spline_V(freq), color='red', marker='X', s=100, zorder=6, 
                label=f'Estimación en {freq} kHz' if freq == 41.0 else "")
plt.title('Voltaje V(f) vs Frecuencia de Excitación', fontsize=14)
plt.xlabel('Frecuencia f (kHz)', fontsize=12)
plt.ylabel('Voltaje V (V)', fontsize=12)
plt.grid(True, linestyle='--', alpha=0.7)
plt.legend()

# Gráfico 2: Impedancia vs Frecuencia
plt.subplot(2, 1, 2)
plt.plot(f_smooth, spline_Z(f_smooth), 'g-', label='Spline Cúbico Natural', linewidth=2)
plt.scatter(f, Z, color='black', label='Datos Experimentales', zorder=5, s=20)
for freq in f_eval:
    plt.scatter(freq, spline_Z(freq), color='red', marker='X', s=100, zorder=6,
                label=f'Estimación en {freq} kHz' if freq == 41.0 else "")
plt.title('Impedancia Equivalente |Z(f)| vs Frecuencia de Excitación', fontsize=14)
plt.xlabel('Frecuencia f (kHz)', fontsize=12)
plt.ylabel('Impedancia |Z| (Ohmios)', fontsize=12)
plt.grid(True, linestyle='--', alpha=0.7)
plt.legend()

plt.tight_layout()
plt.show()
