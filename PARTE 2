import numpy as np
import matplotlib.pyplot as plt
from scipy.interpolate import CubicSpline

# 1. Datos del problema
f = np.array([10.0, 12.5, 15.0, 17.5, 20.0, 22.5, 25.0, 27.5, 30.0, 32.5, 35.0, 37.5, 40.0, 42.5, 45.0,
              47.5, 50.0, 52.5, 55.0, 57.5, 60.0, 62.5, 65.0, 67.5, 70.0, 72.5, 75.0, 77.5, 80.0, 82.5,
              85.0, 87.5, 90.0, 92.5, 95.0, 97.5, 100.0, 102.5, 105.0, 107.5])

V = np.array([0.842, 0.911, 0.986, 1.062, 1.143, 1.227, 1.314, 1.401, 1.482, 1.551, 1.216, 1.048, 0.866, 0.689, 0.521,
              0.364, 0.223, 0.103, 0.012, -0.041, -0.057, -0.034, 0.018, 0.096, 0.197, 0.318, 0.452, 0.579, 0.700, 0.809,
              0.611, 0.688, 0.756, 0.811, 0.856, 0.894, 0.926, 0.954, 0.980, 1.004])

# 2. Creación del Spline Cúbico y su Derivada analítica
# Construimos el spline del voltaje
spline_V = CubicSpline(f, V, bc_type='natural')
# Extraemos la función derivada del spline (primera derivada)
spline_dV = spline_V.derivative()

# 3. Cálculo de Resultados Requeridos para imprimir
f_eval_cent = [40.0, 70.0, 100.0]
print("--- RESULTADOS DE DERIVACIÓN (V/kHz) ---")

# Diferencias Centradas (Orden 2 y 4) y comparación con Spline
h = 2.5
for freq in f_eval_cent:
    idx = np.where(f == freq)[0][0]
    # Orden 2
    df2 = (V[idx+1] - V[idx-1]) / (2*h)
    # Orden 4
    df4 = (-V[idx+2] + 8*V[idx+1] - 8*V[idx-1] + V[idx-2]) / (12*h)
    # Spline
    df_spline = spline_dV(freq)
    
    print(f"\nPara f = {freq} kHz:")
    print(f"  Orden 2: {df2:.4f}")
    print(f"  Orden 4: {df4:.4f}")
    print(f"  Spline : {df_spline:.4f}")

# Diferencia Progresiva Orden 2 para f = 10.0
df_prog = (-3*V[0] + 4*V[1] - V[2]) / (2*h)
df_spline_10 = spline_dV(10.0)
print(f"\nPara el extremo f = 10.0 kHz (Progresiva):")
print(f"  Orden 2: {df_prog:.4f}")
print(f"  Spline : {df_spline_10:.4f}")

# 4. Gráficos
f_smooth = np.linspace(f.min(), f.max(), 500)

plt.figure(figsize=(12, 10))

# Gráfico de V(f) original
plt.subplot(2, 1, 1)
plt.plot(f_smooth, spline_V(f_smooth), 'b-', label='Spline Cúbico Natural V(f)')
plt.scatter(f, V, color='black', s=15, label='Datos Experimentales')
plt.title('Voltaje de Salida V(f)')
plt.xlabel('Frecuencia f (kHz)')
plt.ylabel('Voltaje (V)')
plt.grid(True, linestyle='--', alpha=0.6)
plt.legend()

# Gráfico de la Sensibilidad (Derivada)
plt.subplot(2, 1, 2)
plt.plot(f_smooth, spline_dV(f_smooth), 'r-', label='Sensibilidad: dV/df (Derivada del Spline)')
plt.axhline(0, color='black', linewidth=1.2, linestyle='--') # Línea de referencia en cero

# Marcar los puntos calculados con Orden 4 / Progresiva para contrastar
pts_x = [10.0, 40.0, 70.0, 100.0]
pts_y = [df_prog, -0.0726, 0.0447, 0.0119]
plt.scatter(pts_x, pts_y, color='blue', marker='o', s=60, zorder=5, label='Estimaciones Dif. Finitas')

plt.title('Sensibilidad del Sistema dV/df')
plt.xlabel('Frecuencia f (kHz)')
plt.ylabel('Sensibilidad (V / kHz)')
plt.grid(True, linestyle='--', alpha=0.6)
plt.legend()

plt.tight_layout()
plt.show()
